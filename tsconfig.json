{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      "@engine/*": [
        "src/engine/*"
      ],
      "@topics/*": [
        "src/topics/*"
      ]
    }
  },
  "exclude": [
    "remotion.config.ts"
  ],
  "include": [
    "src"
  ]
}
